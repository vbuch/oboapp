{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "followUps"],
  "properties": {
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["incidentId", "classification", "diagnosis", "nextSteps"],
        "properties": {
          "incidentId": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": ["actionable", "recovered", "known", "needs-investigation"]
          },
          "diagnosis": { "type": "string" },
          "nextSteps": { "type": "string" }
        }
      }
    },
    "followUps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "body", "incidentIds"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "body": { "type": "string", "minLength": 1, "maxLength": 15000 },
          "incidentIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
